-- Build-time proof that the callout() TLS boundary (client/callskel.c)
-- reaches a real OpenSSL handshake: connect over TLS to a stable, well-known
-- host, write a plain HTTP/1.1 request, and read back a real response.
--
-- This is intentionally not a test of the Convex client itself (there is
-- none yet -- see setl/README.md) or of the Convex backend. It isolates one
-- claim: the native boundary this whole client design depends on for hosted
-- (TLS) connections genuinely works, hex-encoded strings and all. The
-- eventual client's own TLS transport module will follow this exact
-- request/response shape.

print(callout(0, om, []));

connection := callout(1, om, ["example.com", "443", "5000"]);
print(connection);

if connection(1..3) = "OK:" then
  handle := connection(4..);

  request := "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n";
  written := callout(2, om, [handle, hex request]);
  print(written);

  response := "";
  done := false;
  attempts := 0;
  while not done and attempts < 20 loop
    attempts +:= 1;
    chunk := callout(3, om, [handle, "4096", "3000"]);
    if chunk = "TIMEOUT" or chunk = "EOF" then
      done := true;
    elseif chunk(1..4) = "DATA" then
      response +:= unhex chunk(6..);
    else
      -- an "ERR:..." reply; surface it and stop
      print(chunk);
      done := true;
    end if;
  end loop;

  print(callout(4, om, [handle]));

  if #response >= 5 and response(1..5) = "HTTP/" then
    print("TLS HANDSHAKE AND HTTP ROUND TRIP: OK");
  else
    print("TLS HANDSHAKE AND HTTP ROUND TRIP: FAIL");
  end if;
else
  print("TLS HANDSHAKE AND HTTP ROUND TRIP: FAIL (connect)");
end if;
