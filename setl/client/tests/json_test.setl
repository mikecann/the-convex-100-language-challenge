check_count := 0;
fail_count := 0;

check_count +:= 1; fail_count +:= expect_eq("integer", json_decode(json_encode(42)), 42);
check_count +:= 1; fail_count +:= expect_eq("negative integer", json_decode(json_encode(-7)), -7);
check_count +:= 1; fail_count +:= expect_eq("zero", json_decode(json_encode(0)), 0);
check_count +:= 1; fail_count +:= expect_eq("real", json_decode(json_encode(1.5)), 1.5);
check_count +:= 1; fail_count +:= expect_eq("integral real", json_decode(json_encode(3.0)), 3.0);
check_count +:= 1; fail_count +:= expect_eq("string", json_decode(json_encode("hello world")), "hello world");
check_count +:= 1; fail_count +:= expect_eq("string with quote", json_decode(json_encode("a\"b")), "a\"b");
check_count +:= 1; fail_count +:= expect_eq("string with backslash", json_decode(json_encode("a\\b")), "a\\b");
check_count +:= 1; fail_count +:= expect_eq("string with newline", json_decode(json_encode("a\nb")), "a\nb");
check_count +:= 1; fail_count +:= expect_eq("empty string", json_decode(json_encode("")), "");
check_count +:= 1; fail_count +:= expect_eq("true", json_decode(json_encode(true)), true);
check_count +:= 1; fail_count +:= expect_eq("false", json_decode(json_encode(false)), false);
check_count +:= 1; fail_count +:= expect_eq("null", json_decode(json_encode(om)), om);
check_count +:= 1; fail_count +:= expect_eq("empty array", json_decode(json_encode([])), []);
check_count +:= 1; fail_count +:= expect_eq("array", json_decode(json_encode([1, 2, 3])), [1, 2, 3]);
check_count +:= 1; fail_count +:= expect_eq("nested array", json_decode(json_encode([1, [2, 3], "x"])), [1, [2, 3], "x"]);

obj := {};
obj("count") := 0;
obj("name") := "room-1";
check_count +:= 1; fail_count +:= expect_eq("object", json_decode(json_encode(obj)), obj);

nested := {};
nested("a") := [1, 2];
inner := {};
inner("c") := true;
nested("b") := inner;
check_count +:= 1; fail_count +:= expect_eq("nested object", json_decode(json_encode(nested)), nested);

-- decode-only checks against literal JSON text (things an encoder would
-- never produce itself, like whitespace variety or \u escapes)
obj2 := {};
obj2("x") := 1;
check_count +:= 1; fail_count +:= expect_eq("decode with whitespace", json_decode(" { \"x\" : 1 } "), obj2);
check_count +:= 1; fail_count +:= expect_eq("decode exponent", json_decode("1e2"), 100.0);
check_count +:= 1; fail_count +:= expect_eq("decode negative exponent", json_decode("1.5e1"), 15.0);
check_count +:= 1; fail_count +:= expect_eq("decode unicode escape", json_decode("\"\\u0041\""), "A");
check_count +:= 1; fail_count +:= expect_eq("malformed returns null via json_decode", json_decode("{not json"), om);

[success, value] := json_try_decode("{not json");
check_count +:= 1; fail_count +:= expect_eq("json_try_decode reports failure", success, false);

[success2, value2] := json_try_decode("null");
check_count +:= 1; fail_count +:= expect_eq("json_try_decode true for real null", success2, true);
check_count +:= 1; fail_count +:= expect_eq("json_try_decode value for real null", value2, om);

-- A *nested* null must survive a decode/re-encode round trip: unlike a
-- bare top-level "null", an object key or array element mapped to null is
-- data the caller is entitled to see (Convex's own documented responses
-- send exactly this for an unset optional field), not something this
-- decoder is allowed to quietly drop the way an absent key would be. See
-- this module's own comment for why om alone cannot represent it.
decoded_obj := json_decode("{\"a\":null,\"b\":1}");
check_count +:= 1; fail_count +:= expect_eq("nested null key is present", decoded_obj("a") = om, false);
check_count +:= 1; fail_count +:= expect_eq("nested null key is an atom", is_atom(decoded_obj("a")), true);
check_count +:= 1; fail_count +:= expect_eq("sibling key is unaffected", decoded_obj("b"), 1);
-- A single-key object keeps json_encode_object's key order deterministic
-- (SETL map iteration order is otherwise unspecified across keys), so
-- this round trip can compare the encoded text exactly.
check_count +:= 1; fail_count +:= expect_eq("nested null re-encodes as null", json_encode(json_decode("{\"a\":null}")), "{\"a\":null}");

decoded_arr := json_decode("[1,null,3]");
check_count +:= 1; fail_count +:= expect_eq("nested null keeps array length", #decoded_arr, 3);
check_count +:= 1; fail_count +:= expect_eq("nested null array element is an atom", is_atom(decoded_arr(2)), true);
check_count +:= 1; fail_count +:= expect_eq("array element re-encodes as null", json_encode(decoded_arr), "[1,null,3]");

-- A *trailing* null is its own separate trap for a tuple specifically: "a
-- tuple's length is the index of its last non-om element" (per GNU
-- SETL's own operator reference for #), so a trailing element that really
-- was om -- not the atom this decoder now uses instead -- would have
-- silently shortened the tuple by one. newat() sidesteps that the same
-- way it sidesteps the map problem: an atom is never om, so it always
-- counts.
decoded_trailing := json_decode("[1,2,null]");
check_count +:= 1; fail_count +:= expect_eq("trailing null keeps array length", #decoded_trailing, 3);
check_count +:= 1; fail_count +:= expect_eq("trailing null re-encodes as null", json_encode(decoded_trailing), "[1,2,null]");

-- json_null_to_om (client/convex.setl and client/sync.setl use this at a
-- value's own "top level" so it keeps comparing equal to om): converts a
-- nested-null atom back to om, and passes every other value through
-- unchanged, including one with its own nested null still inside it.
check_count +:= 1; fail_count +:= expect_eq("json_null_to_om converts an atom", json_null_to_om(decoded_arr(2)), om);
check_count +:= 1; fail_count +:= expect_eq("json_null_to_om passes through a real value", json_null_to_om(decoded_obj), decoded_obj);
check_count +:= 1; fail_count +:= expect_eq("json_null_to_om passes through om itself", json_null_to_om(om), om);

print(str(check_count - fail_count) + "/" + str(check_count) + " json checks passed");
if fail_count > 0 then
  stop 1;
end if;

-- expect_eq returns 1 (fail) or 0 (pass), printing a diagnostic on failure;
-- the mainline block above accumulates the result itself rather than this
-- proc mutating a shared counter, keeping every proc a pure function of its
-- arguments.
proc expect_eq(label, actual, expected);
  if actual /= expected then
    print("FAIL " + label + ": got " + str(actual) + " want " + str(expected));
    return 1;
  end if;
  return 0;
end proc;

#include "json.setl"
