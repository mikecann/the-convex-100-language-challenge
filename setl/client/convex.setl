-- Convex HTTP client: query/mutation/action over the documented
-- "format":"json" HTTP API (POST /api/{query,mutation,action}), built on
-- client/http.setl and client/json.setl. This module has no Live/
-- WebSocket support yet -- see setl/README.md.
--
-- A result is always one of:
--   {"kind": "result",  "value": <value>, "logLines": <tuple of string>}
--   {"kind": "error", "errName": <string>, "errMessage": <string>,
--    "errData": <value or om>, "logLines": <tuple of string>}
-- "errName" is "FunctionError" for a structured failure the Convex
-- function itself reported (HTTP 200 with status:"error", or HTTP 560),
-- "ProtocolError" for a 200/560 response that does not match the
-- documented envelope, and "TransportError" for anything else (a 5xx,
-- 408, 429, or a connect/framing failure that never reached Convex).

proc convex_call(deployment_url, endpoint_op, path, args_value, token, timeout_ms);
  [success, target] := convex_parse_url(deployment_url);
  if not success then
    return convex_transport_error(target);
  end if;

  req_body := {};
  req_body("path") := path;
  req_body("args") := args_value;
  req_body("format") := "json";
  body_text := json_encode(req_body);

  headers := {};
  headers("Convex-Client") := "setl-0.1.0";
  if token /= om and #token > 0 then
    headers("Authorization") := "Bearer " + token;
  end if;

  [success, resp] := http_request(target("scheme"), target("host"), target("port"),
      "POST", "/api/" + endpoint_op, headers, body_text, timeout_ms);
  if not success then
    return convex_transport_error(str(resp));
  end if;

  return convex_classify(resp("read_status"), resp("body_text"));
end proc;

proc convex_query(deployment_url, path, args_value, token, timeout_ms);
  return convex_call(deployment_url, "query", path, args_value, token, timeout_ms);
end proc;

proc convex_mutation(deployment_url, path, args_value, token, timeout_ms);
  return convex_call(deployment_url, "mutation", path, args_value, token, timeout_ms);
end proc;

proc convex_action(deployment_url, path, args_value, token, timeout_ms);
  return convex_call(deployment_url, "action", path, args_value, token, timeout_ms);
end proc;

-- Splits a deployment URL of the form scheme://host[:port] (Convex
-- deployment URLs never carry a path) into a map with "scheme" ("tls" for
-- https, "tcp" for http -- the two values client/stream.setl expects),
-- "host", and "port" (an integer, defaulted from the scheme when absent).
proc convex_parse_url(deployment_url);
  sep := find_substring(deployment_url, "://", 1);
  if sep = 0 then
    return [false, "deployment URL is missing a scheme: " + deployment_url];
  end if;
  scheme_text := downcase(deployment_url(1..sep - 1));
  rest := deployment_url(sep + 3..);
  if scheme_text = "https" then
    transport_scheme := "tls";
    default_port := 443;
  elseif scheme_text = "http" then
    transport_scheme := "tcp";
    default_port := 80;
  else
    return [false, "unsupported deployment URL scheme: " + scheme_text];
  end if;

  colon := find_substring(rest, ":", 1);
  target := {};
  target("scheme") := transport_scheme;
  if colon = 0 then
    target("host") := rest;
    target("port") := default_port;
  else
    target("host") := rest(1..colon - 1);
    port_value := val(rest(colon + 1..));
    if port_value = om or not is_integer(port_value) then
      return [false, "malformed port in deployment URL: " + deployment_url];
    end if;
    target("port") := port_value;
  end if;
  return [true, target];
end proc;

proc convex_classify(status_code, body_text);
  if status_code = 200 or status_code = 560 then
    top := json_decode(body_text);
    if top = om or not is_map(top) then
      return convex_protocol_error("HTTP response body was not a JSON object");
    end if;
    call_status := top("status");
    if call_status = om then
      return convex_protocol_error("HTTP response omitted status");
    end if;

    if call_status = "success" and status_code = 200 then
      -- json_decode cannot tell "value key present and JSON null" apart
      -- from "value key absent": a SETL map assignment m(k) := om does
      -- not store an entry (om is also how map lookup reports "no such
      -- key"), so an object like {"value":null} decodes to a map with no
      -- "value" key at all rather than one mapping "value" to om. Both
      -- cases are accepted here as a legitimate null result; see
      -- client/json.setl's module comment for the same limitation.
      return convex_result(top("value"), convex_log_lines(top));
    end if;

    if call_status = "error" or status_code = 560 then
      message := top("errorMessage");
      if message = om then
        message := top("message");
      end if;
      if message = om then
        message := "Convex function failed";
      end if;
      err_data := top("errorData");
      return convex_error("FunctionError", message, err_data, convex_log_lines(top));
    end if;

    return convex_protocol_error("HTTP response had unknown status");
  end if;

  detail := "no Convex error envelope";
  top := json_decode(body_text);
  if top /= om and is_map(top) then
    if top("errorMessage") /= om then
      detail := top("errorMessage");
    elseif top("message") /= om then
      detail := top("message");
    end if;
  end if;
  message := "HTTP " + str(status_code) + " from Convex: " + detail;
  return convex_error("TransportError", message, om, []);
end proc;

proc convex_log_lines(top);
  lines := top("logLines");
  if lines = om or not is_tuple(lines) then
    return [];
  end if;
  return lines;
end proc;

proc convex_result(value, log_lines);
  r := {};
  r("kind") := "result";
  r("value") := value;
  r("logLines") := log_lines;
  return r;
end proc;

proc convex_error(err_name, err_message, err_data, log_lines);
  r := {};
  r("kind") := "error";
  r("errName") := err_name;
  r("errMessage") := err_message;
  r("errData") := err_data;
  r("logLines") := log_lines;
  return r;
end proc;

proc convex_protocol_error(message);
  return convex_error("ProtocolError", message, om, []);
end proc;

proc convex_transport_error(message);
  return convex_error("TransportError", message, om, []);
end proc;
