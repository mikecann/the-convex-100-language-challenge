-- TLS transport for the hosted Convex profile, wrapping the callout()
-- boundary implemented in client/callskel.c (see the block comment there
-- for the exact service codes and wire format). This is the only module
-- that calls callout() directly; everything else in this client only ever
-- sees plain SETL values.
--
-- Same [read_status, payload] shape as client/tcp.setl -- see the comment at
-- the top of that file -- so client/stream.setl can dispatch between the
-- two transports without either one leaking its own representation.

proc tls_connect(target_host, port_num, timeout_ms);
  r := callout(1, om, [target_host, str(port_num), str(timeout_ms)]);
  if #r >= 3 and r(1..3) = "OK:" then
    return [true, r(4..)];
  end if;
  return [false, r];
end proc;

proc tls_write(handle, bytes);
  r := callout(2, om, [handle, hex bytes]);
  if #r >= 3 and r(1..3) = "OK:" then
    return [true, val r(4..)];
  end if;
  return [false, r];
end proc;

proc tls_read(handle, max_bytes, timeout_ms);
  r := callout(3, om, [handle, str(max_bytes), str(timeout_ms)]);
  if r = "TIMEOUT" then
    return ["timeout", om];
  elseif r = "EOF" then
    return ["eof", om];
  elseif #r >= 4 and r(1..4) = "DATA" then
    return ["data", unhex r(6..)];
  else
    return ["error", r];
  end if;
end proc;

proc tls_close(handle);
  callout(4, om, [handle]);
end proc;
