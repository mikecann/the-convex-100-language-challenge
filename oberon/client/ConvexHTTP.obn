(*ConvexHTTP implements one Convex HTTP request/response cycle: connect
  (optionally TLS), write a hand rolled HTTP/1.1 POST request, and read and
  frame the response strictly (Content-Length only; chunked transfer
  encoding is rejected rather than guessed at). It has no knowledge of
  Convex's JSON envelope; ConvexSync builds the JSON payload and interprets
  the returned body.*)
MODULE ConvexHTTP;

	IMPORT J := ConvexJSON, U := ConvexURL, Shim := ConvexShim;

	CONST
		MaxBody* = 2097152; (*2 MiB, matching this client's documented HTTP cap*)
		ChunkCap = 65536;
		RequestCap = 4096;

	(*Post is never reentrant (this client is single threaded), so its large
	  working buffers are static module storage rather than stack allocated.
	  requestLength rides along as module state too: OBNC's nested
	  procedures see only the module's own top level declarations, not an
	  enclosing procedure's locals (no true closures), so the
	  AppendLiteral/AppendCRLF/AppendInt helpers below are module level
	  procedures operating on this shared buffer rather than procedures
	  nested inside Post.*)
	VAR
		globalRequest: ARRAY RequestCap OF CHAR;
		globalRaw: ARRAY MaxBody + 1 OF CHAR;
		globalChunk: ARRAY ChunkCap OF CHAR;
		requestLength: INTEGER;

	PROCEDURE CopyError(text: ARRAY OF CHAR; VAR destination: ARRAY OF CHAR);
	VAR i, n: INTEGER;
	BEGIN
		n := J.TextLength(text);
		IF n > LEN(destination) - 1 THEN n := LEN(destination) - 1 END;
		i := 0;
		WHILE i < n DO destination[i] := text[i]; INC(i) END;
		destination[n] := 0X
	END CopyError;

	PROCEDURE ShimError(VAR destination: ARRAY OF CHAR);
	VAR buf: ARRAY 512 OF CHAR; n: INTEGER;
	BEGIN
		n := Shim.LastError(buf);
		IF n > 511 THEN n := 511 END;
		buf[n] := 0X;
		CopyError(buf, destination)
	END ShimError;

	(*WriteAllBounded writes the whole buffer, resuming after short and
	  would-block writes, until either every byte is sent or deadlineMs (an
	  absolute Shim.MonotonicMs value) passes.*)
	PROCEDURE WriteAllBounded(conn: Shim.Conn; VAR data: ARRAY OF CHAR; length, deadlineMs: INTEGER; VAR ok: BOOLEAN; VAR errorText: ARRAY OF CHAR);
	VAR
		sent, n, sendFd, chunkLength, i, remaining, pollResult: INTEGER;
		ready1, ready2, done: BOOLEAN;
	BEGIN
		sent := 0;
		sendFd := Shim.Fd(conn);
		ok := TRUE;
		done := FALSE;
		WHILE ok & ~done DO
			IF sent >= length THEN
				done := TRUE
			ELSE
				remaining := deadlineMs - Shim.MonotonicMs();
				IF remaining <= 0 THEN
					ok := FALSE;
					CopyError("write deadline exceeded", errorText)
				ELSE
					chunkLength := length - sent;
					IF chunkLength > ChunkCap THEN chunkLength := ChunkCap END;
					i := 0;
					WHILE i < chunkLength DO globalChunk[i] := data[sent + i]; INC(i) END;
					n := Shim.Write(conn, globalChunk, chunkLength);
					IF n = -2 THEN
						ok := FALSE;
						ShimError(errorText)
					ELSIF n = -1 THEN
						pollResult := Shim.Poll2(sendFd, -1, remaining, ready1, ready2);
						IF pollResult < 0 THEN
							ok := FALSE;
							ShimError(errorText)
						END
					ELSE
						sent := sent + n
					END
				END
			END
		END
	END WriteAllBounded;

	(*HeaderLineHasPrefix performs a case-insensitive comparison of the first
	  TextLength(prefix) characters of raw[lineStart..lineEnd) to prefix
	  (which must already be lower case).*)
	PROCEDURE HeaderLineHasPrefix(VAR raw: ARRAY OF CHAR; lineStart, lineEnd: INTEGER; prefix: ARRAY OF CHAR): BOOLEAN;
	VAR prefixLength, i: INTEGER; a: CHAR; ok: BOOLEAN;
	BEGIN
		prefixLength := J.TextLength(prefix);
		ok := lineEnd - lineStart >= prefixLength;
		i := 0;
		WHILE ok & (i < prefixLength) DO
			a := raw[lineStart + i];
			IF (a >= "A") & (a <= "Z") THEN a := CHR(ORD(a) + 32) END;
			IF a # prefix[i] THEN ok := FALSE END;
			INC(i)
		END;
		RETURN ok
	END HeaderLineHasPrefix;

	(*FindHeaderEnd looks for the blank line (CR LF CR LF) ending the HTTP
	  header block within raw[0..rawLength). Returns the index of the first
	  CR of that sequence, or -1 if it has not arrived yet.*)
	PROCEDURE FindHeaderEnd(VAR raw: ARRAY OF CHAR; rawLength: INTEGER): INTEGER;
	VAR i, found: INTEGER;
	BEGIN
		found := -1;
		IF rawLength >= 4 THEN
			i := 0;
			WHILE (found < 0) & (i <= rawLength - 4) DO
				IF (raw[i] = CHR(13)) & (raw[i+1] = CHR(10)) & (raw[i+2] = CHR(13)) & (raw[i+3] = CHR(10)) THEN
					found := i
				END;
				INC(i)
			END
		END;
		RETURN found
	END FindHeaderEnd;

	(*ParseHeaders walks the header block raw[0..headerEnd) looking for
	  Content-Length and Transfer-Encoding.*)
	PROCEDURE ParseHeaders(VAR raw: ARRAY OF CHAR; headerEnd: INTEGER; VAR haveContentLength: BOOLEAN; VAR contentLength: INTEGER; VAR chunked: BOOLEAN);
	VAR lineStart, lineEnd, valueStart, i: INTEGER; parsedOk: BOOLEAN;
	BEGIN
		haveContentLength := FALSE;
		chunked := FALSE;
		contentLength := 0;
		lineStart := 0;
		WHILE lineStart < headerEnd DO
			lineEnd := lineStart;
			WHILE (lineEnd < headerEnd) & (raw[lineEnd] # CHR(13)) DO INC(lineEnd) END;
			IF HeaderLineHasPrefix(raw, lineStart, lineEnd, "content-length:") THEN
				valueStart := lineStart + 15;
				WHILE (valueStart < lineEnd) & (raw[valueStart] = " ") DO INC(valueStart) END;
				parsedOk := valueStart < lineEnd;
				contentLength := 0;
				i := valueStart;
				WHILE i < lineEnd DO
					IF (raw[i] < "0") OR (raw[i] > "9") THEN
						parsedOk := FALSE
					ELSE
						contentLength := contentLength * 10 + (ORD(raw[i]) - ORD("0"))
					END;
					INC(i)
				END;
				IF parsedOk THEN haveContentLength := TRUE END
			END;
			IF HeaderLineHasPrefix(raw, lineStart, lineEnd, "transfer-encoding:") THEN
				chunked := TRUE
			END;
			lineStart := lineEnd + 2
		END
	END ParseHeaders;

	(*Oberon-07 string literals have no backslash escapes ("\r\n" would be
	  four literal characters, not CR LF), so every header line ends with an
	  explicit call to AppendCRLF rather than an embedded escape. These
	  three helpers operate on the module level globalRequest/requestLength
	  state described above (see the note on why they are not nested inside
	  Post).*)
	PROCEDURE AppendLiteral(text: ARRAY OF CHAR);
	VAR n2, i2: INTEGER;
	BEGIN
		n2 := J.TextLength(text);
		i2 := 0;
		WHILE i2 < n2 DO globalRequest[requestLength] := text[i2]; INC(requestLength); INC(i2) END
	END AppendLiteral;

	PROCEDURE AppendCRLF;
	BEGIN
		globalRequest[requestLength] := CHR(13);
		globalRequest[requestLength + 1] := CHR(10);
		INC(requestLength, 2)
	END AppendCRLF;

	PROCEDURE AppendInt(value: INTEGER);
	VAR digits: ARRAY 16 OF CHAR; count, v: INTEGER;
	BEGIN
		IF value = 0 THEN
			globalRequest[requestLength] := "0";
			INC(requestLength)
		ELSE
			count := 0;
			v := value;
			WHILE v > 0 DO
				digits[count] := CHR(ORD("0") + (v MOD 10));
				v := v DIV 10;
				INC(count)
			END;
			WHILE count > 0 DO
				DEC(count);
				globalRequest[requestLength] := digits[count];
				INC(requestLength)
			END
		END
	END AppendInt;

	(*Post performs one request/response cycle: POST payload as
	  application/json to url's path, with an optional bearer token, and
	  return the response body strictly framed by Content-Length. token may
	  be empty (no Authorization header sent). ok reports whether the HTTP
	  transaction itself completed; errorText explains a transport failure
	  such as DNS, connect, TLS, or a malformed/oversized response. A
	  well-formed Convex error envelope is still ok=TRUE - ConvexSync
	  decides what body means.*)
	PROCEDURE Post*(url: ARRAY OF CHAR; VAR payload: ARRAY OF CHAR; token: ARRAY OF CHAR; timeoutMs: INTEGER; VAR body: ARRAY OF CHAR; VAR ok: BOOLEAN; VAR errorText: ARRAY OF CHAR);
	VAR
		secure, connected, closed, chunked, haveContentLength, done: BOOLEAN;
		host: ARRAY 256 OF CHAR;
		path: ARRAY 1024 OF CHAR;
		port, fd: INTEGER;
		conn: Shim.Conn;
		payloadLength, tokenLength: INTEGER;
		deadline, remaining: INTEGER;
		rawLength, headerEnd, bodyStart, contentLength, targetLength: INTEGER;
		n, i, readCap: INTEGER;
		ready1, ready2: BOOLEAN;
	BEGIN
		body[0] := 0X;
		ok := FALSE;
		errorText[0] := 0X;
		deadline := Shim.MonotonicMs() + timeoutMs;
		connected := FALSE;
		closed := FALSE;

		ok := U.Parse(url, secure, host, port, path);
		IF ~ok THEN CopyError("invalid Convex deployment URL", errorText) END;

		IF ok THEN
			remaining := deadline - Shim.MonotonicMs();
			IF remaining < 1 THEN remaining := 1 END;
			fd := Shim.TcpConnect(host, port, remaining);
			IF fd < 0 THEN
				ok := FALSE;
				ShimError(errorText)
			END
		END;

		IF ok THEN
			IF secure THEN
				remaining := deadline - Shim.MonotonicMs();
				IF remaining < 1 THEN remaining := 1 END;
				Shim.TlsWrap(fd, host, remaining, conn);
				IF conn = NIL THEN
					ok := FALSE;
					ShimError(errorText)
				ELSE
					connected := TRUE
				END
			ELSE
				Shim.PlainWrap(fd, conn);
				connected := TRUE
			END
		END;

		IF ok THEN
			payloadLength := J.TextLength(payload);
			tokenLength := J.TextLength(token);

			requestLength := 0;
			AppendLiteral("POST ");
			AppendLiteral(path);
			AppendLiteral(" HTTP/1.1"); AppendCRLF;
			AppendLiteral("Host: "); AppendLiteral(host); AppendCRLF;
			AppendLiteral("Content-Type: application/json"); AppendCRLF;
			AppendLiteral("Connection: close"); AppendCRLF;
			AppendLiteral("Content-Length: ");
			AppendInt(payloadLength);
			AppendCRLF;
			IF tokenLength > 0 THEN
				AppendLiteral("Authorization: Bearer ");
				AppendLiteral(token);
				AppendCRLF
			END;
			AppendCRLF;

			(*payload can be near MaxBody; a value ARRAY OF CHAR parameter is
			  a const reference in this compiler (no stack copy), so writing
			  it directly is both correct and cheap.*)
			WriteAllBounded(conn, globalRequest, requestLength, deadline, ok, errorText)
		END;

		IF ok THEN
			WriteAllBounded(conn, payload, payloadLength, deadline, ok, errorText)
		END;

		IF ok THEN
			rawLength := 0;
			headerEnd := -1;
			haveContentLength := FALSE;
			chunked := FALSE;
			contentLength := 0;
			done := FALSE;

			WHILE ok & ~done DO
				remaining := deadline - Shim.MonotonicMs();
				IF remaining <= 0 THEN
					ok := FALSE;
					CopyError("response timed out", errorText)
				ELSE
					IF ~Shim.Pending(conn) THEN
						n := Shim.Poll2(Shim.Fd(conn), -1, remaining, ready1, ready2);
						IF n < 0 THEN
							ok := FALSE;
							ShimError(errorText)
						END
					END;
					IF ok & (rawLength >= MaxBody) THEN
						ok := FALSE;
						CopyError("response exceeded the 2 MiB cap", errorText)
					END;
					IF ok THEN
						readCap := MaxBody - rawLength;
						IF readCap > ChunkCap THEN readCap := ChunkCap END;
						n := Shim.Read(conn, globalChunk, readCap);
						IF n = -2 THEN
							ok := FALSE;
							ShimError(errorText)
						ELSIF n = -1 THEN
							(*spurious wakeup; poll again*)
						ELSIF n = 0 THEN
							done := TRUE (*peer closed the connection*)
						ELSE
							i := 0;
							WHILE i < n DO globalRaw[rawLength + i] := globalChunk[i]; INC(i) END;
							INC(rawLength, n);
							IF headerEnd < 0 THEN
								headerEnd := FindHeaderEnd(globalRaw, rawLength);
								IF headerEnd >= 0 THEN
									bodyStart := headerEnd + 4;
									ParseHeaders(globalRaw, headerEnd, haveContentLength, contentLength, chunked);
									IF chunked THEN
										ok := FALSE;
										CopyError("chunked transfer encoding is not supported", errorText)
									END
								END
							END;
							IF ok & (headerEnd >= 0) & haveContentLength THEN
								targetLength := bodyStart + contentLength;
								IF targetLength > MaxBody THEN
									ok := FALSE;
									CopyError("response exceeded the 2 MiB cap", errorText)
								ELSIF rawLength >= targetLength THEN
									done := TRUE
								END
							END
						END
					END
				END
			END
		END;

		(*A single unconditional close, reached whichever way the steps
		  above stopped, covers both the error paths and the ordinary
		  peer-closed / target-reached loop exits.*)
		IF connected & ~closed THEN
			Shim.CloseConn(conn);
			closed := TRUE
		END;

		IF ok & (headerEnd < 0) THEN
			ok := FALSE;
			CopyError("connection closed before headers completed", errorText)
		END;
		IF ok & haveContentLength & (rawLength < bodyStart + contentLength) THEN
			ok := FALSE;
			CopyError("connection closed before the declared body was received", errorText)
		END;

		IF ok THEN
			IF haveContentLength THEN n := contentLength ELSE n := rawLength - bodyStart END;
			IF n >= LEN(body) THEN
				ok := FALSE;
				CopyError("response body exceeded the caller's buffer", errorText)
			ELSE
				i := 0;
				WHILE i < n DO body[i] := globalRaw[bodyStart + i]; INC(i) END;
				body[n] := 0X
			END
		END
	END Post;

END ConvexHTTP.
