opam-version: "2.0"
synopsis: "Educational native OCaml Convex client"
description: "Build metadata used only inside the demonstration Docker image."
version: "0.1.0"
maintainer: "educational@example.invalid"
authors: [ "100 Convex Clients contributors" ]
homepage: "https://github.com/mikecann/100-convex-clients"
bug-reports: "https://github.com/mikecann/100-convex-clients/issues"
depends: [
  "ocaml" { = "5.2.1" }
  "dune" { = "3.17.2" }
  "yojson" { = "2.2.2" }
  "ssl" { = "0.7.0" }
  "ocamlformat" { = "0.27.0" }
]
