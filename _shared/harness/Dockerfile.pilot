ARG CLIENT_IMAGE=100-convex-clients-go:local
FROM ${CLIENT_IMAGE} AS client

FROM node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e

WORKDIR /harness
COPY _shared/harness/package.json _shared/harness/package-lock.json ./
RUN npm ci --ignore-scripts
COPY _shared/harness/scripts ./scripts
COPY _shared/harness/reference-js ./reference-js
COPY --from=client /usr/local/bin/convex-go-adapter /client/convex-go-adapter
COPY --from=client /etc/ssl/certs/ca-certificates.crt /client/ca-certificates.crt

# The pilot copies the adapter into the controller image to give the controller
# direct NDJSON pipes. Point Go at the exact CA bundle from its final image so
# hosted TLS is still testing the client artifact, not the Node base image.
ENV SSL_CERT_FILE=/client/ca-certificates.crt

USER node
CMD ["npm", "run", "pilot"]
