cabal-version:      3.0
name:               haskell-convex
version:            0.1.0
build-type:         Simple

library
  exposed-modules:     Convex
  hs-source-dirs:      .
  build-depends:       base >=4.18 && <5, aeson >=2.2 && <2.3, base64-bytestring >=1.2 && <1.3,
                       bytestring >=0.12 && <0.13, containers >=0.7 && <0.8,
                       async >=2.2 && <2.3, http-client >=0.7 && <0.8,
                       http-client-tls >=0.3 && <0.4, http-types >=0.12 && <0.13,
                       network >=3.1 && <3.3, stm >=2.5 && <2.6,
                       text >=2.0 && <2.2, uuid >=1.3 && <1.4,
                       websockets >=0.13 && <0.14, wuss >=2.0 && <2.1
  default-language:    GHC2021
  ghc-options:         -Wall -Wcompat

executable convex-example
  main-is:             Main.hs
  hs-source-dirs:      ../examples/basics
  build-depends:       base, aeson, haskell-convex, text, uuid
  default-language:    GHC2021
  ghc-options:         -Wall -Wcompat

executable convex-adapter
  main-is:             Main.hs
  hs-source-dirs:      tests/conformance
  build-depends:       base, aeson, async, bytestring, containers, haskell-convex, network, stm, text
  default-language:    GHC2021
  ghc-options:         -Wall -Wcompat

test-suite local
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      tests/live
  build-depends:       base, aeson, async, base64-bytestring, bytestring, cryptohash-sha1,
                       haskell-convex, network, stm, text, websockets
  default-language:    GHC2021
  ghc-options:         -Wall -Wcompat

test-suite adapter-local
  type:                exitcode-stdio-1.0
  main-is:             AdapterTest.hs
  hs-source-dirs:      tests/conformance
  build-depends:       base, aeson, bytestring, network, process, text, websockets
  default-language:    GHC2021
  ghc-options:         -Wall -Wcompat

test-suite http-local
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      tests/http
  build-depends:       base, aeson, async, bytestring, haskell-convex, network, stm, text
  default-language:    GHC2021
  ghc-options:         -Wall -Wcompat
