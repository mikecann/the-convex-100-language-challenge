%   convex-dns.clu -- a minimal DNS A-record resolver, used in place of
%   pclu's own bundled client/tests/fixtures-adjacent DNS client,
%   lib/clu/_resolve.clu.
%
%   _resolve.clu's own resolv.conf reader only recognises lines
%   starting with ';' as comments (an Ultrix/BSD convention from its
%   1985/1989 MIT copyright header); every modern Linux resolv.conf,
%   including the one Docker generates for every container this
%   client's own local and hosted verification profiles run in, uses
%   '#' instead ("# Generated by Docker Engine."). _resolve's parser
%   does not skip that line -- it treats it as the domain/nameserver
%   line its own fixed line-1/line-2 position assumption expects,
%   fails to parse it as an address, silently swallows that failure
%   (an "except others: end" around the whole block), and is left
%   querying the untouched default of 127.0.0.1, where nothing is
%   listening. The DNS query then times out every time, which is
%   indistinguishable from this client's own code -- until traced with
%   strace against a real "backend" hostname lookup -- from a genuinely
%   unreachable nameserver. Rather than patch unfamiliar 1980s DNS
%   wire-format C this client cannot easily verify byte for byte, this
%   module is a small, from-scratch resolver this client owns and
%   tests directly: read the real nameserver out of /etc/resolv.conf
%   (correctly, past '#' and ';' comments and blank lines), send one
%   A-record query over UDP, and parse the first matching answer.
%
%   convex-transport.clu's own dial() calls this exactly where it used
%   to call _resolve$n2a, with the same three signals, so this
%   substitution is invisible to every other module in this client.

dns = cluster is resolve, encode_qname, parse_a_record

rep = null

AF_INET = 2
SOCK_DGRAM = 2
DNS_PORT = 53
QUERY_TIMEOUT_MS = 3000

	byte_c = proc (v: int) returns (string)
	    return(string$c2s(char$i2c(v)))
	    end byte_c

	byte_at = proc (s: string, i: int) returns (int)
	    return(char$c2i(s[i]))
	    end byte_at

	is_ws = proc (c: char) returns (bool)
	    return(c = ' ' cor c = '\t' cor c = '\r' cor c = '\n')
	    end is_ws

	trim = proc (s: string) returns (string)
	    n: int := string$size(s)
	    lo: int := 1
	    hi: int := n
	    while lo <= hi cand is_ws(s[lo]) do lo := lo + 1 end
	    while hi >= lo cand is_ws(s[hi]) do hi := hi - 1 end
	    if lo > hi then return("") end
	    return(string$substr(s, lo, hi - lo + 1))
	    end trim

%   read_nameserver() -> the first "nameserver X" line's address in
%   /etc/resolv.conf, skipping every comment ('#' or ';') and blank
%   line rather than assuming any fixed line position, so it finds the
%   real entry no matter how many comment lines -- Docker's file has
%   several -- come before it.
	read_nameserver = proc () returns (string) signals (no_server)
	    ch: _chan := _chan$open(file_name$parse("/etc/resolv.conf"),
				    "read", 0)
		except when not_possible (ignored: string): signal no_server end
	    buf: _wordvec := _wordvec$create(4096 / 4)
	    n: int := _chan$getw(ch, buf)
	    _chan$close(ch) except others: end
	    rbytes: _bytevec := _bytevec$create(n)
	    _wordvec$move_w2b(buf, 1, rbytes, 1, n)
	    text: string := _cvt[_bytevec, string](rbytes)

	    pos: int := 1
	    tn: int := string$size(text)
	    while pos <= tn do
		nl: int := string$indexc('\n', string$rest(text, pos))
		line: string
		if nl = 0
		   then line := string$rest(text, pos)
			pos := tn + 1
		   else line := string$substr(text, pos, nl - 1)
			pos := pos + nl
		   end
		trimmed: string := trim(line)
		if string$size(trimmed) >= 11 cand
		   trimmed[1] ~= '#' cand trimmed[1] ~= ';' cand
		   string$equal(string$substr(trimmed, 1, 11), "nameserver ")
		   then
			rest: string := trim(string$rest(trimmed, 12))
			sp: int := string$indexc(' ', rest)
			if sp ~= 0 then rest := string$substr(rest, 1, sp - 1)
			    end
			return(rest)
		   end
		end
	    signal no_server
	    end read_nameserver

%   encode_qname(name) -> name as DNS length-prefixed labels ("host",
%   "example", "com" for host.example.com), terminated by a zero byte.
	encode_qname = proc (name: string) returns (string)
	    out: string := ""
	    start: int := 1
	    n: int := string$size(name)
	    i: int := 1
	    while i <= n + 1 do
		if i > n cor name[i] = '.' then
		    label: string := string$substr(name, start, i - start)
		    out := out || byte_c(string$size(label)) || label
		    start := i + 1
		    end
		i := i + 1
		end
	    return(out || byte_c(0))
	    end encode_qname

%   build_query(name) -> a standard recursive A-record query packet and
%   its own random-ish transaction ID (this module never has more than
%   one query in flight at a time, so the ID only has to be a
%   plausible-looking 16-bit value, not collision-proof).
	build_query = proc (name: string) returns (string, int)
	    id: int := _real_time() // 65536
	    hdr: string := byte_c(id / 256) || byte_c(id // 256)
	    hdr := hdr || byte_c(1) || byte_c(0)	% flags: RD=1
	    hdr := hdr || byte_c(0) || byte_c(1)	% QDCOUNT=1
	    hdr := hdr || byte_c(0) || byte_c(0)	% ANCOUNT=0
	    hdr := hdr || byte_c(0) || byte_c(0)	% NSCOUNT=0
	    hdr := hdr || byte_c(0) || byte_c(0)	% ARCOUNT=0
	    question: string := encode_qname(name) || byte_c(0) || byte_c(1)
	    question := question || byte_c(0) || byte_c(1)
	    return(hdr || question, id)
	    end build_query

%   skip_name(resp, pos) -> the index one past the domain name that
%   starts at pos, whether it is spelled inline (length-prefixed labels
%   ending in a zero byte, always true of the question section this
%   client's own query echoes back) or as a 2-byte compression pointer
%   (0xC0 in the top two bits, the usual shape of an answer record's own
%   name, which nearly always just points back at the question).
	skip_name = proc (resp: string, pos: int) returns (int)
						   signals (bad_format)
	    n: int := string$size(resp)
	    while true do
		if pos > n then signal bad_format end
		b: int := byte_at(resp, pos)
		if b = 0 then return(pos + 1) end
		if b >= 192 then return(pos + 2) end
		pos := pos + 1 + b
		end
	    end skip_name

%   parse_a_record(resp) -> the dotted-quad text of the first A/IN
%   answer in resp, skipping the question section (whatever it echoed
%   back) and any answer that is not itself a 4-byte A record (a CNAME,
%   say) rather than assuming the first answer is always the right
%   shape.
	parse_a_record = proc (resp: string) returns (string)
					   signals (not_found, bad_format)
	    n: int := string$size(resp)
	    if n < 12 then signal bad_format end
	    qdcount: int := byte_at(resp, 5) * 256 + byte_at(resp, 6)
	    ancount: int := byte_at(resp, 7) * 256 + byte_at(resp, 8)

	    pos: int := 13
	    i: int := 1
	    while i <= qdcount do
		pos := skip_name(resp, pos)
		    resignal bad_format
		pos := pos + 4
		i := i + 1
		end

	    i := 1
	    while i <= ancount do
		pos := skip_name(resp, pos)
		    resignal bad_format
		if pos + 9 > n then signal bad_format end
		rtype: int := byte_at(resp, pos) * 256 + byte_at(resp, pos + 1)
		rclass: int := byte_at(resp, pos + 2) * 256
				+ byte_at(resp, pos + 3)
		rdlength: int := byte_at(resp, pos + 8) * 256
				  + byte_at(resp, pos + 9)
		pos := pos + 10
		if rtype = 1 cand rclass = 1 cand rdlength = 4 then
		    return(int$unparse(byte_at(resp, pos)) || "."
			   || int$unparse(byte_at(resp, pos + 1)) || "."
			   || int$unparse(byte_at(resp, pos + 2)) || "."
			   || int$unparse(byte_at(resp, pos + 3)))
		    end
		pos := pos + rdlength
		i := i + 1
		end
	    signal not_found
	    end parse_a_record

%   resolve(name) -> name's first A record, as the same (int, int)
%   address-half pair inet_address itself returns, so
%   convex-transport.clu's dial() can feed either straight into the
%   _wordvec sockaddr it builds by hand.
	resolve = proc (name: string) returns (int, int)
				     signals (not_found, no_server, timeout)
	    ns: string := read_nameserver()
		resignal no_server
	    packet: string, id: int := build_query(name)

	    ch: _chan := _chan$socket(AF_INET, SOCK_DGRAM, 0)
		except when not_possible (ignored: string): signal no_server end

	    l: int, r: int := inet_address(ns)
		except when bad_format:
			    _chan$close(ch) except others: end
			    signal no_server
		       end
	    addr: _wordvec := _wordvec$create(4)
	    _wordvec$wstore(addr, 1, AF_INET)
	    _wordvec$wstore(addr, 3, (DNS_PORT / 2**8) + (DNS_PORT * 2**8))
	    _wordvec$wstore(addr, 5, r)
	    _wordvec$wstore(addr, 7, l)

	    plen: int := string$size(packet)
	    sbuf: _wordvec := _wordvec$create((plen + 3) / 4)
	    _wordvec$move_b2w(_cvt[string, _bytevec](packet), 1, sbuf, 1, plen)
	    _chan$sendto(ch, sbuf, plen, 0, addr, 16)
		except when not_possible (ignored: string):
			    _chan$close(ch) except others: end
			    signal no_server
		       when bounds:
			    _chan$close(ch) except others: end
			    signal no_server
		       end

	    ready: bool := _chan$read_wait(ch, QUERY_TIMEOUT_MS)
	    if ~ready then
		_chan$close(ch) except others: end
		signal timeout
		end
	    rbuf: _wordvec := _wordvec$create(512 / 4)
	    fromaddr: _wordvec := _wordvec$create(4)
	    got: int, alen: int := _chan$recvfrom(ch, rbuf, 0, fromaddr)
		except when not_possible (ignored: string): signal timeout end
	    _chan$close(ch) except others: end
	    rbytes: _bytevec := _bytevec$create(got)
	    _wordvec$move_w2b(rbuf, 1, rbytes, 1, got)
	    resp: string := _cvt[_bytevec, string](rbytes)

	    dotted: string := parse_a_record(resp)
		except when bad_format: signal not_found end
		resignal not_found
	    % A return statement's expression list is positional, one
	    % value per slot (see convex-http.clu's call for the first
	    % time this client hit that): inet_address's own two return
	    % values have to land in named locals first, not be forwarded
	    % straight out of a single-expression return(inet_address(...)).
	    fl: int, fr: int := inet_address(dotted)
		except when bad_format: signal not_found end
	    return(fl, fr)
	    end resolve

end dns
