%   websocket_fixture.clu -- a genuine RFC 6455 WebSocket peer (not a
%   mock) for websocket_test.clu, in the same spirit as
%   echo_fixture.clu/http_fixture.clu: listens on 127.0.0.1:<port>,
%   completes one real handshake (computing its own Sec-WebSocket-Accept
%   the same way a real server would, with this client's own sha1/
%   base64), then runs one fixed scripted exchange designed to exercise
%   every RFC 6455 behaviour convex-websocket.clu's own recv_message has
%   to get right in one pass: it unmasks the client's single data frame
%   for real (so a masking bug would corrupt the echoed text, not just
%   fail an assertion this file would otherwise have to make itself),
%   echoes it back split across two fragments with a Ping control frame
%   interleaved between them, then sends a Close frame. Like its two
%   sibling fixtures, this file does not itself assert anything -- the
%   pass/fail judgement belongs entirely to websocket_test.clu, which
%   only sees a correct transcript if every one of those behaviours
%   actually worked.

	fx_byte_at = proc (s: string, i: int) returns (int)
	    return(char$c2i(s[i]))
	    end fx_byte_at

	fx_byte_c = proc (v: int) returns (string)
	    return(string$c2s(char$i2c(v)))
	    end fx_byte_c

%   fx_fill(ch, buf, n) -> buf grown by reading from ch until it holds
%   at least n bytes (or the peer closes early, in which case it returns
%   whatever it has -- this fixture's own script then simply fails to
%   find the bytes it expected, which surfaces as a clear test failure
%   rather than a hang).
	fx_fill = proc (ch: _chan, buf: string, n: int) returns (string)
	    while string$size(buf) < n do
		ready: bool := _chan$read_wait(ch, 5000)
		if ~ready then return(buf) end
		rbuf: _wordvec := _wordvec$create(4096)
		got: int := _chan$recv(ch, rbuf, 0)
		if got = 0 then return(buf) end
		rbytes: _bytevec := _bytevec$create(got)
		_wordvec$move_w2b(rbuf, 1, rbytes, 1, got)
		buf := buf || _cvt[_bytevec, string](rbytes)
		end
	    return(buf)
	    end fx_fill

	fx_send = proc (ch: _chan, s: string)
	    n: int := string$size(s)
	    if n = 0 then return end
	    buf: _wordvec := _wordvec$create((n + 3) / 4)
	    _wordvec$move_b2w(_cvt[string, _bytevec](s), 1, buf, 1, n)
	    _chan$send(ch, buf, n, 0)
	    end fx_send

%   fx_frame(opcode, payload, fin) -> a complete, unmasked server frame
%   (RFC 6455 section 5.1: a server never masks). Payload is assumed
%   under 126 bytes, which is all this fixture's own fixed script ever
%   sends -- a real server needs the 16/64-bit extended-length cases
%   convex-websocket.clu's own build_frame implements; this one does not,
%   deliberately, to keep a test peer a test peer.
	fx_frame = proc (opcode: int, payload: string, fin: bool) returns (string)
	    b0: int := opcode
	    if fin then b0 := b0 + 128 end
	    return(fx_byte_c(b0) || fx_byte_c(string$size(payload)) || payload)
	    end fx_frame

%   fx_unmask(payload, key) -> payload XORed against the cycling 4-byte
%   mask key -- the same operation convex-websocket.clu's own mask()
%   uses to mask outbound client frames, since XOR is its own inverse.
	fx_unmask = proc (payload, key: string) returns (string)
	    n: int := string$size(payload)
	    out: string := ""
	    i: int := 1
	    while i <= n do
		k: int := fx_byte_at(key, ((i - 1) // 4) + 1)
		out := out || fx_byte_c(bitops$xor_byte(fx_byte_at(payload, i), k))
		i := i + 1
		end
	    return(out)
	    end fx_unmask

	fx_header_value = proc (headers, name: string) returns (string)
						       signals (not_found)
	    pos: int := 1
	    n: int := string$size(headers)
	    while pos <= n do
		nl: int := string$indexs("\r\n", string$rest(headers, pos))
		line: string
		if nl = 0
		   then line := string$rest(headers, pos)
			pos := n + 1
		   else line := string$substr(headers, pos, nl - 1)
			pos := pos + nl + 1
		   end
		if string$size(line) > string$size(name) cand
		   string$equal(string$substr(line, 1, string$size(name)), name)
		   then return(string$substr(line, string$size(name) + 1,
					      string$size(line) -
					      string$size(name)))
		   end
		end
	    signal not_found
	    end fx_header_value

start_up = proc ()
    po: stream := stream$primary_output()
    GUID: string := "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    AF_INET: int := 2
    SOCK_STREAM: int := 1
    port: int := int$parse(sequence[string]$fetch(get_argv(), 1))

    addr: _wordvec := _wordvec$create(4)
    _wordvec$wstore(addr, 1, AF_INET)
    _wordvec$wstore(addr, 3, (port / 2**8) + (port * 2**8))
    l, r: int := inet_address("127.0.0.1")
    _wordvec$wstore(addr, 5, r)
    _wordvec$wstore(addr, 7, l)

    lch: _chan := _chan$socket(AF_INET, SOCK_STREAM, 0)
    _chan$bind(lch, addr, 16)
    _chan$listen(lch, 1)
    stream$putl(po, "READY")

    peeraddr: _wordvec := _wordvec$create(4)
    ch: _chan, alen: int := _chan$accept(lch, peeraddr)

    % -- handshake: read the request, answer with a real Sec-WebSocket-
    % Accept computed the same way convex-websocket.clu's own connect()
    % checks it, so a bug in this client's sha1/base64 would make the
    % test fail here too, not just in sha1_test.clu/base64_test.clu.
    buf: string := ""
    header_end: int := 0
    while header_end = 0 do
	buf := fx_fill(ch, buf, string$size(buf) + 1)
	header_end := string$indexs("\r\n\r\n", buf)
	end
    header_text: string := string$substr(buf, 1, header_end + 3)
    buf := string$rest(buf, header_end + 4)
    key: string := fx_header_value(header_text, "Sec-WebSocket-Key: ")
    accept: string := base64$encode(sha1$digest(key || GUID))
    fx_send(ch, "HTTP/1.1 101 Switching Protocols\r\n" ||
		"Upgrade: websocket\r\n" ||
		"Connection: Upgrade\r\n" ||
		"Sec-WebSocket-Accept: " || accept || "\r\n\r\n")

    % -- one client data frame: read its header, then its 4-byte mask
    % key and payload (this fixture's own script only ever receives a
    % short, unfragmented, unextended-length frame), and unmask it for
    % real.
    buf := fx_fill(ch, buf, 2)
    b1: int := fx_byte_at(buf, 2)
    len7: int := b1 // 128
    buf := string$rest(buf, 3)
    buf := fx_fill(ch, buf, 4 + len7)
    mkey: string := string$substr(buf, 1, 4)
    masked_payload: string := string$substr(buf, 5, len7)
    buf := string$rest(buf, 4 + len7 + 1)
    payload: string := fx_unmask(masked_payload, mkey)

    % -- reply: the unmasked text, "echo:" prefixed, split across two
    % fragments (opcode text, fin=false; then opcode continuation,
    % fin=true) with a Ping sent in between them -- exactly the
    % interleaved-control-frame-during-fragmentation case AGENTS.md's
    % Live-acceptance rules call out.
    echo_text: string := "echo:" || payload
    split: int := 5
    frag1: string := string$substr(echo_text, 1, split)
    frag2: string := string$rest(echo_text, split + 1)
    fx_send(ch, fx_frame(1, frag1, false))
    fx_send(ch, fx_frame(9, "ping-mid-frag", true))
    fx_send(ch, fx_frame(0, frag2, true))

    % Drain the client's automatic Pong reply to that Ping (best
    % effort -- this fixture does not assert on it, but reading it
    % keeps the exchange tidy rather than leaving it in the closing
    % socket's receive buffer).
    buf := fx_fill(ch, buf, string$size(buf) + 2)

    % -- close handshake: send a Close frame carrying a real status
    % code and reason, then give the client a moment to send its own
    % answering Close frame (RFC 6455 section 5.5.1) before tearing
    % down.
    fx_send(ch, fx_frame(8, fx_byte_c(1000 / 256) || fx_byte_c(1000 // 256)
			     || "bye", true))
    _chan$read_wait(ch, 2000)

    _chan$close(ch)
    _chan$close(lch)
    end start_up
