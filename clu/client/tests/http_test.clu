%   http_test.clu -- real loopback coverage for chttp$call (client/
%   convex-http.clu): a genuine HTTP/1.1 round trip against client/tests/
%   fixtures/http_fixture.clu (a real TCP peer, not a mock), proving
%   Content-Length framing, chunked transfer-encoding framing, and the
%   documented "format":"json" success/error envelope classification all
%   the way through to a decoded field. pclu has no async-subprocess-
%   spawn primitive a CLU program could use to start its own fixture the
%   way some of this repository's other language tests do, so the
%   Dockerfile starts one http_fixture per port this test is given,
%   each with its own canned response file, before running this binary.

check = cluster is ok, fail_count

rep = null

own failures: int := 0

	ok = proc (name: string, got: bool)
	    po: stream := stream$primary_output()
	    if got
	       then stream$putl(po, "PASS " || name)
	       else stream$putl(po, "FAIL " || name)
		    failures := failures + 1
	       end
	    end ok

	fail_count = proc () returns (int)
	    return(failures)
	    end fail_count

end check

start_up = proc ()
    po: stream := stream$primary_output()
    args: sequence[string] := get_argv()
    success_port: int := int$parse(sequence[string]$fetch(args, 1))
    chunked_port: int := int$parse(sequence[string]$fetch(args, 2))
    error_port: int := int$parse(sequence[string]$fetch(args, 3))

    % A plain Content-Length response decodes to a "result" whose value
    % text round-trips correctly through json$field/json$uint32.
    begin
	base: string := "http://127.0.0.1:" || int$unparse(success_port)
	kind, value, en, em, ed: string
	hed: bool
	logs_raw: string
	has_logs: bool
	kind, value, en, em, ed, hed, logs_raw, has_logs :=
	    chttp$call("query", "demo:state",
		       json$object1("room", json$qs("a")), base, "")
	check$ok("Content-Length response classifies as a result",
		 string$equal(kind, "result"))
	n: int := json$uint32(json$field(value, "count"))
	    except when not_found, bad_format: n := -1 end
	check$ok("Content-Length response value decodes to count 0", n = 0)
	end

    % A chunked Transfer-Encoding response decodes the same way.
    begin
	base: string := "http://127.0.0.1:" || int$unparse(chunked_port)
	kind, value, en, em, ed: string
	hed: bool
	logs_raw: string
	has_logs: bool
	kind, value, en, em, ed, hed, logs_raw, has_logs :=
	    chttp$call("query", "demo:state",
		       json$object1("room", json$qs("a")), base, "")
	check$ok("chunked response classifies as a result",
		 string$equal(kind, "result"))
	n: int := json$uint32(json$field(value, "count"))
	    except when not_found, bad_format: n := -1 end
	check$ok("chunked response value decodes to count 0", n = 0)
	end

    % A {"status":"error", HTTP 560} response classifies as a structured
    % FunctionError with the unquoted message text, not a transport
    % failure and not a raw JSON string still carrying its quotes.
    begin
	base: string := "http://127.0.0.1:" || int$unparse(error_port)
	kind, value, en, em, ed: string
	hed: bool
	logs_raw: string
	has_logs: bool
	kind, value, en, em, ed, hed, logs_raw, has_logs :=
	    chttp$call("query", "demo:state",
		       json$object1("room", json$qs("a")), base, "")
	check$ok("HTTP 560 response classifies as an error",
		 string$equal(kind, "error"))
	check$ok("HTTP 560 response reports FunctionError",
		 string$equal(en, "FunctionError"))
	check$ok("HTTP 560 error message is unquoted", string$equal(em, "boom"))
	end

    if check$fail_count() > 0
       then stream$putl(po, int$unparse(check$fail_count()) || " FAILED")
	    _exit(1)
       else stream$putl(po, "ALL PASS")
       end
    end start_up
