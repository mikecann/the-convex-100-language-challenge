; Godot project configuration for the Convex GDScript demonstration.
;
; It lives under client/ because it is build metadata, not educational source.
; The Docker build moves it to the root of a temporary project tree, next to
; client/ and examples/, so every script can refer to its neighbours through
; ordinary res:// paths.
;
; run/main_loop_type selects the program the exported pack runs. The adapter
; pack keeps the value below; the Docker build rewrites it to
; ConvexExampleMain before exporting the canonical example pack, so each
; runtime image contains exactly one entry point.

config_version=5

[application]

config/name="convex"
config/description="Educational native Convex client for Godot 4"
config/features=PackedStringArray("4.4", "GDScript")
run/main_loop_type="ConvexAdapterMain"
; NDJSON is only useful if each line leaves the process when it is written,
; rather than waiting in a buffer until exit.
run/flush_stdout_on_print=true
run/flush_stdout_on_print.debug=true

[debug]

settings/stdout/print_fps=false
settings/stdout/verbose_stdout=false

[network]

limits/tcp/connect_timeout_seconds=10

[physics]

; Nothing here simulates anything. The main loops drive their own polling, so
; the engine's own tick rate is kept as low as the setting allows.
common/physics_ticks_per_second=1

[rendering]

renderer/rendering_method="gl_compatibility"

[threading]

; The shared harness runs the adapter container with a small process limit,
; and this program does its own polling, so the engine's worker pool stays
; deliberately small.
worker_pool/max_threads=1
