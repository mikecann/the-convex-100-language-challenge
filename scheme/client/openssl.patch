+                              (substring peer-name 0 last)
+                              peer-name)))
+          (ssl-set-peer-name! ssl peer-name))
         (when sni-name
           (ssl-set-tlsext-hostname! ssl sni-name))
         (ssl-set-connect-state! ssl)
