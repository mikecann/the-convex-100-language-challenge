@@ -299,5 +300,28 @@
   (void))

+;; OpenSSL verifies the trust chain when SSL_VERIFY_PEER is enabled, but it
+;; does not compare the certificate identity with the requested server unless
+;; the caller configures a verification parameter. Treat an IP literal as an
+;; IP SAN and every other name as a DNS hostname.
+(define (ssl-set-peer-name! ssl hostname)
+  (ssl-clear-error)
+  (unless
+   ((foreign-lambda*
+     bool ((c-pointer ssl) (c-string hostname))
+     "X509_VERIFY_PARAM *param = SSL_get0_param((SSL *)ssl);\n"
+     "int result = 0;\n"
+     "if (param != NULL) {\n"
+     "  result = X509_VERIFY_PARAM_set1_ip_asc(param, hostname);\n"
+     "  if (result != 1) {\n"
+     "    ERR_clear_error();\n"
+     "    X509_VERIFY_PARAM_set_hostflags(param, X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS);\n"
+     "    result = X509_VERIFY_PARAM_set1_host(param, hostname, 0);\n"
+     "  }\n"
+     "}\n"
+     "C_return(result == 1);")
+    ssl hostname)
+   (ssl-abort 'ssl-set-peer-name! #f hostname)))
+
 (define (ssl-set-fd! ssl fd)
   (ssl-clear-error)
   (ssl-result-or-abort
